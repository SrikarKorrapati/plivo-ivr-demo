# Copy this file to .env and fill in your values.

# Plivo credentials (console.plivo.com -> Overview page)
PLIVO_AUTH_ID=your_auth_id
PLIVO_AUTH_TOKEN=your_auth_token

# The Plivo number the call comes from, and the "live associate" number to forward to
PLIVO_NUMBER=+918035454161
ASSOCIATE_NUMBER=+912264236412

# Your phone number, in international format (pre-filled on the dashboard)
TARGET_NUMBER=+91XXXXXXXXXX

# Optional: your own public URL (for example from ngrok).
# Leave empty and the app opens a free Cloudflare tunnel for you.
PUBLIC_URL=

# Optional: a different MP3 for "press 1", for example Plivo's sample
# https://s3.amazonaws.com/plivocloud/Trumpet.mp3 (default: static/audio/jingle.mp3)
AUDIO_URL=
